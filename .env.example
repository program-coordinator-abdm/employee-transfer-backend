PORT=4000
# Example: AWS RDS PostgreSQL
# Required for Prisma migrations and API runtime
DATABASE_URL="postgresql://user:password@rds-endpoint:5432/dbname?sslmode=require"
# Required for JWT auth
JWT_SECRET="replace_with_strong_secret"
JWT_EXPIRES_IN="1d"
CORS_ORIGIN="https://www.hfwgeneralpost.com,https://hfwgeneralpost.com,http://localhost:5173"
# Optional explicit frontend origins
VERCEL_FRONTEND_URL="https://your-app.vercel.app"
CUSTOM_FRONTEND_URL="https://hfwgeneralpost.com,https://www.hfwgeneralpost.com"
# Optional: allow all *.vercel.app preview origins
ALLOW_VERCEL_PREVIEW_ORIGINS="true"
PUBLIC_BASE_URL="http://localhost:4000"

# AWS S3 uploads
# Required for API runtime
AWS_REGION="ap-south-1"
AWS_S3_BUCKET="your-public-bucket-name"
# Optional: use public-read ACL on upload (if bucket allows ACLs)
AWS_S3_PUBLIC_READ="false"
# Optional: override public URL base (e.g. CloudFront)
PUBLIC_UPLOAD_BASE_URL="https://your-cdn.example.com"
# Optional: 5MB default
MAX_UPLOAD_MB="5"
# Optional: comma-separated allowlist, e.g. image/jpeg,image/png,application/pdf
ALLOWED_UPLOAD_MIME_TYPES=""
# Optional generic document gzip compression tuning (non-image)
MIN_GZIP_BYTES="1024"
MIN_GZIP_SAVINGS_BYTES="256"
