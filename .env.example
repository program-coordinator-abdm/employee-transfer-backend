PORT=4000
# Example: AWS RDS PostgreSQL
DATABASE_URL="postgresql://user:password@rds-endpoint:5432/dbname?sslmode=require"
JWT_SECRET="replace_with_strong_secret"
JWT_EXPIRES_IN="1d"
CORS_ORIGIN="http://localhost:5173"
PUBLIC_BASE_URL="http://localhost:4000"

# Uploads are stored in RDS (PostgreSQL BYTEA) via /uploads endpoint
# Optional: 5MB default
MAX_UPLOAD_MB="5"
# Optional: comma-separated allowlist, e.g. image/jpeg,image/png,application/pdf
ALLOWED_UPLOAD_MIME_TYPES=""
