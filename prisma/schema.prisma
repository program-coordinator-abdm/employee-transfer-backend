datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                String     @id @default(uuid())
  username          String     @unique
  email             String     @unique
  phone             String     @unique
  password          String
  profilePictureUrl String?
  createdAt         DateTime   @default(now())
  transfersCreated  Transfer[] @relation("TransfersCreated")
}

model Employee {
  id              String     @id @default(uuid())
  empName         String
  empKgid         String     @unique
  role            String
  yearsOfWork     Int
  dob             DateTime
  currentCity     String
  currentPosition String
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  transfers       Transfer[]
}

model Transfer {
  id              String   @id @default(uuid())
  employeeId      String
  employee        Employee @relation(fields: [employeeId], references: [id])
  fromCity        String
  fromPosition    String
  toCity          String
  toPosition      String
  effectiveFrom   DateTime
  createdAt       DateTime @default(now())
  createdByUserId String
  createdByUser   User     @relation("TransfersCreated", fields: [createdByUserId], references: [id])
  remarks         String?

  @@index([employeeId])
  @@index([createdByUserId])
}
