generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                Int        @id @default(autoincrement())
  username          String     @unique
  email             String     @unique
  phone             String?
  password          String
  role              UserRole
  profilePictureUrl String?
  createdAt         DateTime   @default(now()) @db.Timestamp(6)
  transfersCreated  Transfer[] @relation("TransfersCreated")
  vacanciesCreated  Vacancy[]  @relation("VacanciesCreated")
}

model Employee {
  id                           Int                         @id @default(autoincrement())
  empName                      String
  empKgid                      String                      @unique
  designation                  String
  designationGroup             String
  designationSubGroup          String
  dateOfEntry                  DateTime                    @db.Timestamp(6)
  dateOfJoining                DateTime                    @db.Timestamp(6)
  gender                       String
  dob                          DateTime                    @db.Timestamp(6)
  yearsOfWork                  Int?
  currentPostHeld              String
  currentPostGroup             String
  currentPostSubGroup          String
  currentInstitution           String
  currentDistrict              String
  currentTaluk                 String
  currentCityTownVillage       String
  currentWorkingSince          DateTime                    @db.Timestamp(6)
  currentDesignation           String?
  email                        String
  phoneNumber                  String
  telephoneNumber              String?
  address                      String
  pinCode                      String
  officeAddress                String
  officePinCode                String
  officeEmail                  String
  officePhoneNumber            String
  officeTelephoneNumber        String?
  postAppliedFor               String?
  submittedOn                  DateTime?                   @db.Timestamp(6)
  objections                   String?
  probationaryPeriod           Boolean
  probationaryPeriodDoc        String?
  terminallyIll                Boolean
  terminallyIllDoc             String?
  pregnantOrChildUnderOne      Boolean
  pregnantOrChildUnderOneDoc   String?
  retiringWithinTwoYears       Boolean
  retiringWithinTwoYearsDoc    String?
  childSpouseDisability        Boolean
  childSpouseDisabilityDoc     String?
  divorceeWidowWithChild       Boolean
  divorceeWidowWithChildDoc    String?
  spouseGovtServant            Boolean
  spouseGovtServantDoc         String?
  createdAt                    DateTime                    @default(now()) @db.Timestamp(6)
  updatedAt                    DateTime                    @default(now()) @updatedAt @db.Timestamp(6)
  firstPostHeld                String?
  probationDeclarationDate     DateTime?
  cltCompleted                 Boolean                     @default(false)
  cltCompletedDoc              String?
  currentFirstPostHeld         String?
  currentAreaType              String?
  spouseDesignation            String?
  spouseDistrict               String?
  spouseTaluk                  String?
  spouseCityTownVillage        String?
  ngoBenefits                  Boolean                     @default(false)
  ngoBenefitsDoc               String?
  isDoctorNursePharmacist      Boolean                     @default(false)
  hprId                        String?
  hfrId                        String?
  timeboundApplicable          Boolean                     @default(false)
  timeboundCategory            String?
  timeboundYears               String?
  timeboundDoc                 String?
  timeboundDate                DateTime?
  promotionRejected            Boolean                     @default(false)
  promotionRejectedDate        DateTime?
  pgBond                       Boolean                     @default(false)
  pgBondDoc                    String?
  pgBondCompletionDate         DateTime?
  recruitmentType              String?
  contractRegularised          Boolean                     @default(false)
  contractRegularisedDoc       String?
  contractRegularisedDate      DateTime?
  currentInstitutionType       String?
  currentHfrId                 String?
  cltCompletionDate            DateTime?
  timebound6Years              Boolean                     @default(false)
  timebound6YearsDoc           String?
  timebound13Years             Boolean                     @default(false)
  timebound13YearsDoc          String?
  timebound20Years             Boolean                     @default(false)
  timebound20YearsDoc          String?
  promotionRejectedDesignation String?
  contractJoiningDate          DateTime?
  timebound6YearsDate          DateTime?
  timebound13YearsDate         DateTime?
  timebound20YearsDate         DateTime?
  timebound10Years             Boolean                     @default(false)
  timebound10YearsDoc          String?
  timebound10YearsDate         DateTime?
  timebound15Years             Boolean                     @default(false)
  timebound15YearsDoc          String?
  timebound15YearsDate         DateTime?
  currentServiceDoc            String?
  directRecruitmentMode        String?
  permanentAddress             Json?
  currentAddress               Json?
  timebound25Years             Boolean                     @default(false)
  timebound25YearsDoc          String?
  timebound25YearsDate         DateTime?
  timebound30Years             Boolean                     @default(false)
  timebound30YearsDoc          String?
  timebound30YearsDate         DateTime?
  directRecruitmentOther       String?
  educationLevel               String?
  mdSpecialization             String?
  departmentalExamCompleted    Boolean                     @default(false)
  departmentalExamInputName    String?
  departmentalExamDocument     String?
  createdByUsername            String?
  otherStateLocation           String?
  achievements                 Achievement[]
  additionalCharges            AdditionalCharge[]
  administrativeRoles          AdministrativeRole[]
  appointmentDetails           AppointmentDetails?
  assignmentHistory            AssignmentHistory[]
  declaration                  Declaration?
  disciplinaryRecord           DisciplinaryRecord?
  documents                    Document[]
  educations                   Education[]
  pastServices                 PastService[]
  postgraduateQualifications   PostgraduateQualification[]
  serviceInformation           ServiceInformation?
  timeboundPromotions          TimeboundPromotion[]
  transfers                    Transfer[]

  @@index([designationGroup])
  @@index([designationSubGroup])
  @@index([createdByUsername])
}

model EmployeeImportStaging {
  id                     Int      @id @default(autoincrement())
  slNo                   String?
  categorySerialNumber   String?
  district               String?
  kgid                   String?
  applicationReference   String?
  doctorName             String?
  dateOfBirth            String?
  dateOfEntryIntoService String?
  presentWorkingPlace    String?
  presentWorkingFromDate String?
  bAreaCompletedYears    String?
  bAreaMarks             String?
  aAreaCompletedYears    String?
  aAreaMarks             String?
  cAreaCompletedYears    String?
  cAreaMarks             String?
  totalYears             String?
  totalMarks             String?
  category               String?
  remarks                String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @default(now()) @updatedAt

  @@index([kgid])
  @@index([applicationReference])
}

model AssignmentHistory {
  id         Int            @id @default(autoincrement())
  employeeId Int
  role       String
  city       String
  hospital   String
  position   String
  district   String?
  startedOn  DateTime       @db.Timestamp(6)
  endedOn    DateTime?      @db.Timestamp(6)
  period     String?
  type       AssignmentType
  createdAt  DateTime       @default(now()) @db.Timestamp(6)
  employee   Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([employeeId])
}

model PastService {
  id                 Int      @id @default(autoincrement())
  employeeId         Int
  postHeld           String
  postGroup          String
  postSubGroup       String
  institution        String
  district           String
  taluk              String?
  cityTownVillage    String?
  fromDate           DateTime @db.Timestamp(6)
  toDate             DateTime @db.Timestamp(6)
  tenure             String?
  firstPostHeld      String?
  joiningDocument    String?
  institutionType    String?
  hfrId              String?
  otherStateLocation String?
  employee           Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([employeeId])
}

model Education {
  id                   Int      @id @default(autoincrement())
  employeeId           Int
  type                 String?
  qualification        String?
  degree               String?
  institution          String?
  university           String?
  year                 String?
  specialization       String?
  level                String?
  institutionName      String?
  yearOfPassing        String?
  gradePercentage      String?
  documentName         String?
  documentUrl          String?
  documentSizeKB       Float?
  documentUploadedAt   String?
  customEducationLevel String?
  otherStateLocation   String?
  employee             Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([employeeId])
}

model PostgraduateQualification {
  id             Int      @id @default(autoincrement())
  employeeId     Int
  qualification  String?
  degree         String?
  institution    String?
  university     String?
  year           String?
  specialization String?
  employee       Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([employeeId])
}

model TimeboundPromotion {
  id         Int       @id @default(autoincrement())
  employeeId Int
  label      String
  status     String
  order      String?
  date       DateTime? @db.Timestamp(6)
  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([employeeId])
}

model AdministrativeRole {
  id         Int       @id @default(autoincrement())
  employeeId Int
  role       String
  fromDate   DateTime? @db.Timestamp(6)
  toDate     DateTime? @db.Timestamp(6)
  details    String?
  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([employeeId])
}

model AdditionalCharge {
  id          Int       @id @default(autoincrement())
  employeeId  Int
  designation String
  place       String?
  fromDate    DateTime? @db.Timestamp(6)
  toDate      DateTime? @db.Timestamp(6)
  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([employeeId])
}

model Achievement {
  id          Int             @id @default(autoincrement())
  employeeId  Int
  type        AchievementType
  description String
  employee    Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([employeeId])
}

model DisciplinaryRecord {
  id                    Int      @id @default(autoincrement())
  employeeId            Int      @unique
  departmentalEnquiries String?
  suspensionPeriods     String?
  punishmentsReceived   String?
  criminalProceedings   String?
  pendingLegalMatters   String?
  employee              Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model Declaration {
  id                Int       @id @default(autoincrement())
  employeeId        Int       @unique
  empDeclAgreed     Boolean
  empDeclName       String?
  empDeclDate       DateTime? @db.Timestamp(6)
  officerDeclAgreed Boolean
  officerDeclName   String?
  officerDeclDate   DateTime? @db.Timestamp(6)
  remarks           String?
  employee          Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model Document {
  id          Int       @id @default(autoincrement())
  employeeId  Int
  name        String
  sizeKB      Float?
  uploadedAt  DateTime? @db.Timestamp(6)
  downloadUrl String?
  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([employeeId])
}

model ServiceInformation {
  id                      Int      @id @default(autoincrement())
  employeeId              Int      @unique
  deputedByGovernment     String?
  specialistService       String?
  trainingInHospitalAdmin String?
  spouseInGovtService     String?
  spouseServiceDetails    String?
  employee                Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model AppointmentDetails {
  id                       Int       @id @default(autoincrement())
  employeeId               Int       @unique
  slNoInOrder              String?
  orderNoAndDate           String?
  dateOfInitialAppointment DateTime? @db.Timestamp(6)
  employee                 Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model Transfer {
  id              Int      @id @default(autoincrement())
  employeeId      Int
  fromCity        String
  fromPosition    String
  toCity          String
  toPosition      String
  effectiveFrom   DateTime @db.Timestamp(6)
  createdAt       DateTime @default(now()) @db.Timestamp(6)
  createdByUserId Int
  remarks         String?
  createdByUser   User     @relation("TransfersCreated", fields: [createdByUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  employee        Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([employeeId])
  @@index([createdByUserId])
}

model TransferFlatRecord {
  id                                                        Int      @id @default(autoincrement())
  slNo                                                      String?
  categorySlNo                                              String?
  currentDistrict                                           String?
  kgid                                                      String?
  employeeName                                              String?
  dateOfBirth                                               String?
  dateOfEntryIntoService                                    String?
  presentPlaceOfWorking                                     String?
  gbaYears                                                  String?
  gbaMarks                                                  String?
  aYears                                                    String?
  aMarks                                                    String?
  bYears                                                    String?
  bMarks                                                    String?
  cYears                                                    String?
  cMarks                                                    String?
  totalYears                                                String?
  totalMarks                                                String?
  categoryName                                              String?
  remarks                                                   String?
  designation                                               String?
  specialization                                            String?
  createdAt                                                 DateTime @default(now())
  updatedAt                                                 DateTime @default(now()) @updatedAt
  specialCatTerminalIllnessSelected                         Boolean  @default(false)
  specialCatTerminalIllnessDocument                         String?
  specialCatPregnantOrChildUnderOneSelected                 Boolean  @default(false)
  specialCatPregnantOrChildUnderOneDocument                 String?
  specialCatRetiringWithinTwoYearsSelected                  Boolean  @default(false)
  specialCatRetiringWithinTwoYearsDocument                  String?
  specialCatDisabilityFortyPercentSelected                  Boolean  @default(false)
  specialCatDisabilityFortyPercentDocument                  String?
  specialCatWidowWidowerDivorceeWithChildrenUnder12Selected Boolean  @default(false)
  specialCatWidowWidowerDivorceeWithChildrenUnder12Document String?
  specialCatSpouseGovtEmployeeSelected                      Boolean  @default(false)
  specialCatSpouseGovtEmployeeDocument                      String?
  specialCatKsgeaElectedMemberSelected                      Boolean  @default(false)
  specialCatKsgeaElectedMemberDocument                      String?

  @@index([kgid])
  @@index([currentDistrict])
  @@index([categoryName])
}

/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model Vacancy {
  id                  String        @id @default(uuid())
  institutionTypeName String
  institutionName     String
  district            String
  taluk               String
  cityOrTownOrVillage String
  cityIsOther         Boolean       @default(false)
  cityOtherName       String?
  createdByUserId     Int?
  createdBy           String?
  updatedByUserId     Int?
  updatedBy           String?
  createdByUser       User?         @relation("VacanciesCreated", fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  lines               VacancyLine[]

  @@index([district])
  @@index([taluk])
  @@index([institutionName])
  @@index([createdByUserId])
  @@index([updatedByUserId])
  @@index([createdAt])
}

model VacancyLine {
  id                  String  @id @default(uuid())
  vacancyId           String
  designationName     String
  sanctionedPositions Int
  filled              Int
  vacant              Int
  vacancy             Vacancy @relation(fields: [vacancyId], references: [id], onDelete: Cascade)

  @@index([vacancyId])
}

enum UserRole {
  ADMIN
  DATA_OFFICER
  TRANSFER_OPERATOR
  TRANSFER_OFFICER
}

enum AssignmentType {
  current
  additional
  past
  rural
  contract
  admin
}

enum AchievementType {
  significant
  special
}
